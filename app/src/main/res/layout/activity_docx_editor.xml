<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Document"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <!-- Formatting row 1 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button android:id="@+id/btnBold" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="B" android:textStyle="bold" android:textSize="15sp" />
            <Button android:id="@+id/btnItalic" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="I" android:textStyle="italic" android:textSize="15sp" />
            <Button android:id="@+id/btnUnderline" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="U" android:textSize="15sp" />
            <Button android:id="@+id/btnStrike" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="S" android:textSize="15sp" />
            <Button android:id="@+id/btnBullets" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="@string/bullet_list" android:textSize="13sp" />
            <Button android:id="@+id/btnNumbers" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="@string/number_list" android:textSize="13sp" />
            <Button android:id="@+id/btnImage" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="@string/insert_image" android:textSize="13sp" />
            <Button android:id="@+id/btnTable" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="@string/insert_table" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Formatting row 2 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">

            <Spinner android:id="@+id/spinHeading" android:layout_width="120dp" android:layout_height="40dp"
                android:layout_margin="2dp" />
            <Spinner android:id="@+id/spinFont" android:layout_width="120dp" android:layout_height="40dp"
                android:layout_margin="2dp" />
            <Spinner android:id="@+id/spinSize" android:layout_width="90dp" android:layout_height="40dp"
                android:layout_margin="2dp" />
            <Button android:id="@+id/btnTextColor" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="A" android:textSize="15sp" />
            <Button android:id="@+id/btnHighlight" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="10dp"
                android:text="ab" android:textSize="13sp" />
            <Button android:id="@+id/btnAlignLeft" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="⇤" android:textSize="15sp" />
            <Button android:id="@+id/btnAlignCenter" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="≡" android:textSize="15sp" />
            <Button android:id="@+id/btnAlignRight" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="⇥" android:textSize="15sp" />
            <Button android:id="@+id/btnAlignJustify" android:layout_width="44dp" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:text="☰" android:textSize="15sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.omnidoc.app.RichEditorView
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/editor_paper" />

    <!-- Action row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button android:id="@+id/btnUndo" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/undo" android:textSize="13sp" />
            <Button android:id="@+id/btnRedo" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/redo" android:textSize="13sp" />
            <Button android:id="@+id/btnFind" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/find_replace" android:textSize="13sp" />
            <Button android:id="@+id/btnCount" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/word_count" android:textSize="13sp" />
            <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="14dp"
                android:text="@string/save" android:textSize="13sp" />
            <Button android:id="@+id/btnSaveAs" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/save_as" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
