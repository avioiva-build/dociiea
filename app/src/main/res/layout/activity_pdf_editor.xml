<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Edit pages"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <TextView
        android:id="@+id/txtSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="Tap pages to select"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:alpha="0.8" />

    <!-- Selection action row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button android:id="@+id/btnRotate" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/rotate" android:textSize="13sp" />
            <Button android:id="@+id/btnUp" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/move_up" android:textSize="13sp" />
            <Button android:id="@+id/btnDown" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/move_down" android:textSize="13sp" />
            <Button android:id="@+id/btnDelete" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/delete_pages" android:textSize="13sp" />
            <Button android:id="@+id/btnUndoAll" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="Reset" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Document action row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button android:id="@+id/btnAppend" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/append_pdf" android:textSize="13sp" />
            <Button android:id="@+id/btnExtract" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:text="@string/extract_pages" android:textSize="13sp" />
            <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="2dp" android:minWidth="0dp" android:paddingHorizontal="14dp"
                android:text="@string/save" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerThumbs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />
</LinearLayout>
